{%- liquid
  assign bg_color = section.settings.background_color | default: '#FF6B35'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign button_bg = section.settings.button_background | default: '#FFFFFF'
  assign button_text = section.settings.button_text_color | default: '#FF6B35'
-%}

<style>
  .pre-footer-section {
    background: {{ bg_color }};
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
    border-radius: clamp(20px, 3vw, 40px);
    margin: clamp(40px, 6vw, 80px) clamp(16px, 4vw, 40px);
  }

  .pre-footer-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    min-height: 400px;
  }

  .pre-footer-content {
    z-index: 2;
    position: relative;
  }

  .pre-footer-tag {
    color: {{ text_color }};
    margin-bottom: clamp(12px, 2vw, 20px);
    opacity: 0.9;
  }

  .pre-footer-title {
    color: {{ text_color }};
    margin: 0 0 clamp(16px, 3vw, 24px) 0;
  }

  .pre-footer-description {
    font-size: clamp(14px, 1.5vw, 18px);
    line-height: 1.6;
    color: {{ text_color }};
    opacity: 0.9;
    margin: 0 0 clamp(24px, 4vw, 32px) 0;
    max-width: 500px;
  }

  .pre-footer-button {
    display: inline-flex;
    align-items: center;
    background: {{ button_bg }};
    color: {{ button_text }};
    padding: clamp(12px, 2vw, 16px) clamp(24px, 4vw, 32px);
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: clamp(14px, 1.5vw, 16px);
    transition: all 0.3s ease;
    gap: 8px;
  }

  .pre-footer-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    background: {{ button_bg }};
    color: {{ button_text }};
  }

  .pre-footer-button svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .pre-footer-image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  .pre-footer-image {
    max-width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: contain;
  }

  /* Decorative elements */
  .pre-footer-section::before {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    top: -150px;
    right: -150px;
    z-index: 1;
  }

  .pre-footer-section::after {
    content: '';
    position: absolute;
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 50%;
    bottom: -100px;
    left: -100px;
    z-index: 1;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .pre-footer-container {
      grid-template-columns: 1fr;
      gap: clamp(30px, 5vw, 40px);
      text-align: center;
    }

    .pre-footer-description {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .pre-footer-section {
      margin: clamp(30px, 5vw, 60px) clamp(16px, 4vw, 24px);
      border-radius: clamp(16px, 2vw, 24px);
    }

    .pre-footer-container {
      min-height: 300px;
    }
  }

  @media (max-width: 480px) {
    .pre-footer-section {
      margin: clamp(20px, 4vw, 40px) clamp(12px, 3vw, 16px);
    }

    .pre-footer-container {
      gap: clamp(20px, 4vw, 30px);
    }
  }
</style>

<div class="pre-footer-section section-padding">
  <div class="pre-footer-container page-width">
    <div class="pre-footer-content">
      {%- if section.settings.tag_text != blank -%}
        <div class="pre-footer-tag h2">{{ section.settings.tag_text }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="pre-footer-title section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <p class="pre-footer-description">{{ section.settings.description }}</p>
      {%- endif -%}
      
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="pre-footer-button">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 4V2C7 1.45 7.45 1 8 1H16C16.55 1 17 1.45 17 2V4H20C20.55 4 21 4.45 21 5S20.55 6 20 6H19V17C19 18.1 18.1 19 17 19H7C5.9 19 5 18.1 5 17V6H4C3.45 6 3 5.55 3 5S3.45 4 4 4H7ZM9 3V4H15V3H9ZM7 6V17H17V6H7Z"/>
          </svg>
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="pre-footer-image-wrapper">
      {%- if section.settings.product_image != blank -%}
        <img 
          src="{{ section.settings.product_image | image_url: width: 500 }}" 
          alt="{{ section.settings.product_image.alt | escape }}"
          class="pre-footer-image"
          loading="lazy"
          width="500"
          height="auto"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pre Footer",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag Text",
      "default": "Reduce Your Stress with Every Sip",
      "info": "Small text above the main title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Reduce Your Stress with Every Sip",
      "info": "Main heading for the section"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover the soothing comfort in our power shakes and adaptogen-infused coffees. Nurture yourself with each delicious choice.",
      "info": "Description text below the title"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Go to Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "info": "Leave empty to disable button"
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Product image - recommended size: 500x400px"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FF6B35"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FF6B35"
    }
  ],
  "presets": [
    {
      "name": "Pre Footer",
      "settings": {
        "tag_text": "Reduce Your Stress with Every Sip",
        "title": "Reduce Your Stress with Every Sip",
        "description": "Discover the soothing comfort in our power shakes and adaptogen-infused coffees. Nurture yourself with each delicious choice.",
        "button_label": "Go to Shop"
      }
    }
  ]
}
{% endschema %}
