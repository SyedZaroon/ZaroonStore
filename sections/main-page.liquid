{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    
  }
.custom-content{
      display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
  .bg-color{
    background-color:{{ section.settings.bg_color }};
    position:relative;
  }

  .top-left-img {
    position: absolute;
    top: 0;
    left: 0;
}

 .bottom-right-img {
    position: absolute;
    bottom: 0;
    right: 0;
}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="bg-color" >
<div class="page-width page-width--narrow section-{{ section.id }}-padding">

  <div class="custom-content" >
    {%- if section.settings.custom_tag !=blank -%}
      <h2 class="h2 tagline">{{ section.settings.custom_tag }}</h2>
    {%- endif -%}
    
  <h1 style="text-align:center" class="section-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {%- if section.settings.custom_title !=blank -%}
      {{ section.settings.custom_title }}
          {%- else -%}
    {{ page.title | escape }}
    {%- endif -%}
  </h1>

   {%- if section.settings.custom_desc !=blank -%}
      <p class="">{{ section.settings.custom_desc }}</p>
    {%- endif -%}

  </div>



     <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div> 

</div>
<img 
  src="{{ section.settings.bottom_right_img | image_url: width: 150 }}" 
  alt="Footer image"
  width="auto"
  height="auto"
  class="bottom-right-img"
>
  <img 
  src="{{ section.settings.top_left_img | image_url: width: 150 }}" 
  alt="Header image"
  width="auto"
  height="auto"
  class="top-left-img"
>

</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content",
    },
    {
      "type": "text",
      "id": "custom_tag",
      "label": "Tagline",
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Heading",
    },
    {
      "type": "text",
      "id": "custom_desc",
      "label": "Description",
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
        {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDF7F0",
    },
    {
      "type": "header",
      "content": "Corner Images",
    },
    {
      "type": "image_picker",
      "id": "top_left_img",
      "label": "Top Left Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_img",
      "label": "Bottom Right Image"
    },
  ]
}
{% endschema %}
