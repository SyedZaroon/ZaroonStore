          "id": "description",
          "label": "Card Description",
          "default": "Our shakes support your body and mind with nourishing ingredients for lasting energy and focus."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Daily Habits Matter",
      "settings": {
        "tag_text": "Daily Habits Matter",
        "title": "Foundation for Healthier Life",
        "subtitle": "Choose Powerhouse for delicious drinks that boost energy, focus, and wellness with adaptogen support."
      },
      "blocks": [
        {
          "type": "habit_card",
          "settings": {
            "title": "Signature Power Shakes",
            "description": "Our shakes support your body and mind with nourishing ingredients for lasting energy and focus."
          }
        },
        {
          "type": "habit_card",
          "settings": {
            "title": "Sip to Feel Better",
            "description": "Enjoy our power shakes and adaptogen coffees that help you stay focused and energized throughout the day."
          }
        },
        {
          "type": "habit_card",
          "settings": {
            "title": "Adaptogen Coffees",
            "description": "Enjoy delicious blends that help manage stress and enhance well-being with every sip."
          }
        },
        {
          "type": "habit_card",
          "settings": {
            "title": "Find Calm in Every Sip",
            "description": "Our adaptogen-infused coffees naturally help your body manage stress and feel more balanced."
          }
        }
      ]
    }
  ]
}
{% endschema %}
