{%- liquid
  assign bg_color = section.settings.background_color | default: '#FAFAFA'
  assign accent_color = section.settings.accent_color | default: '#FF6B35'
  assign text_color = section.settings.text_color | default: '#2C2C2C'
  assign accent_color_rgb = accent_color | color_to_rgb | remove: 'rgb(' | remove: ')'
-%}

<style>
  .product-overview-section {
    background-color: {{ bg_color }};
    text-align: center;
    position: relative;
  }

  .product-overview-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .product-overview-tag {
    display: inline-block;
    color: {{ accent_color }};
    margin-bottom: clamp(8px, 1vw, 16px);
    letter-spacing: 0.5px;
  }

  .product-overview-title {
    color: {{ text_color }};
    margin: 0 auto clamp(40px, 6vw, 80px);
  }

  .product-overview-content {
    display: grid;
    grid-template-columns: 1fr 400px 1fr;
    gap: 13px;
    align-items: center;
    min-height: 500px;
  }

  .benefits-left,
  .benefits-right {
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 4vw, 50px);
  }

  .benefit-card {
    position: relative;
    padding: clamp(16px, 3vw, 24px);
  }

  .benefits-left .benefit-card{
    text-align:right;
  }

  .benefits-right .benefit-card{
    text-align:left;
  }


  .benefit-icon {
    width: 48px;
    height: 48px;
    background: {{ accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: clamp(12px, 2vw, 16px);
    position: relative;
  }

  .benefits-left .benefit-icon{
    margin-left:auto;
  }

  .benefits-right .benefit-icon{
    margin-right:auto;
  }


  .benefit-icon svg {
    width: 26px;
    height: 26px;
    fill: white;
  }

  .benefit-title {
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 700;
    color: {{ text_color }};
    margin: 0 0 clamp(8px, 1vw, 12px) 0;
    line-height: 1.3;
  }

  .benefit-description {
    color: #666666;
  }

  .benefit-card.right-align .benefit-description {
    margin-left: auto;
  }

  .product-image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2;
  }

  .product-overview-image {
    max-width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    border-radius: 12px;
  }

  /* Connecting lines */
  .benefit-card::after {
    content: '';
    position: absolute;
    width: 50px;
    height: 50px;
    background-image: url({{ 'product-overview-arrow.png' | asset_url }});
    top: 23%;
    background-size: contain;
    background-repeat: no-repeat;
  }

  .benefits-left .benefit-card::after {
    right: -30px;
  }

  .benefits-right .benefit-card::after {
    left: -30px;
        transform: scaleX(-1);
  }


  /* Responsive Design */
  @media (max-width: 1024px) {
    .product-overview-content {
      grid-template-columns: 1fr 1fr;
      gap: 13px;
      text-align: center;
    }

    .benefits-left .benefit-card,
    .benefits-right .benefit-card
 {
      text-align: left;
    }

    .benefits-left .benefit-icon
    {
      margin-left:0px;

    }
    .benefits-right .benefit-icon{
            margin-right: 0px;
    }

    .benefit-card{
      padding:unset;
    }

    .benefit-card::after {
      display: none;
    }

    .product-image-wrapper{
      position: sticky;
    top: 110px;
    align-self: start;
    height: fit-content;
    }

    .benefits-left, .benefits-right{
      gap:unset;
    }
  }


  @media (max-width: 500px) {

    .benefits-left,
    .benefits-right,
    .product-overview-content {
      grid-template-columns: 1fr;
    }

     .product-image-wrapper{
      position: unset;
    }

    .product-overview-section {
      padding: clamp(40px, 8vw, 60px) clamp(16px, 4vw, 24px);
    }
  }
</style>

<div class="product-overview-section section-padding">
  <div class="product-overview-container page-width ">
    {%- if section.settings.tag_text != blank -%}
      <div class="product-overview-tag h2">{{ section.settings.tag_text }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="product-overview-title section-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="product-overview-content">
      <!-- Left Benefits -->
      <div class="benefits-left">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit_card' and block.settings.position == 'left' -%}
