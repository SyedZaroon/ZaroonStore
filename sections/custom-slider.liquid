
  <!-- 1️⃣ Include Slick CSS from CDN -->
<link
  rel="stylesheet"
  type="text/css"
  href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
/>
<link
  rel="stylesheet"
  type="text/css"
  href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"
/> 

<style>



.slide-content a {
    text-decoration: none;
    color: black;
}
.slick-initialized .slick-slide{
  display:flex;
}
.slider-main {
    width: 95%;
    margin: 20px auto;
    {% comment %} height: 50%; {% endcomment %}
    position: relative;
    /* Full viewport height */

}

.slide {
    width: 100%;
    height: 80vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    margin: 0px 10px;
    border-radius: 10px;
    padding: 0px 50px 80px;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: relative;
    z-index: 0;
}

.slide::before {
    position: absolute;
    content: "";
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.315);
    top: 0;
    left: 0;
    border-radius: 10px;
    z-index: 1;

}

.slide:hover {
    cursor: grab
}


.slide-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 99999;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.089);
    position: relative;
}

.slide-content-heading {
    color: white;
    width: clamp(400px, 600px, 600px);
    font-size: clamp(1rem, 3.368vw, 4rem);
    cursor: default;
}

.slide-content-btn {
    cursor: pointer;
    padding: 16px 32px;
    background-color: #fff;
    border-radius: 50px;
    transition: all 0.3s ease-in-out;
    border: 1px solid transparent;
    position: relative;
    z-index: 1;
    color: black;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.slide-content-btn:hover {
    border: 1px solid white;
    color: white;
}

.slide-content-btn .btn-fill {
    background-color: #000000;
    border-radius: 50%;
    width: 150%;
    height: 200%;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 0);
    transition: transform 0.4s ease-in-out;
    z-index: 0;
    /* Set below text */
}

.slide-content-btn:hover .btn-fill {
    transform: translate(-50%, -90%);
}

.slide-content-btn .btn-text {
    position: relative;
    z-index: 2;
    /* Text above fill */
    transition: color 0.3s ease-in-out;
}



/* Slick slider dots customization */

.slick-dots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 30px;
    display: flex;
    list-style: none;
    justify-content:center
}


.slick-dots li button {
    width: 6px;
    height: 6px;
    background-color: rgb(255, 255, 255);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-size: 0;
}
.slick-dots li{
  margin:0;
}

.slick-dots li button:before {
    content: none;
}

.slick-dots li.slick-active button {
    background-color: #000000;
    position: relative;
}

.slick-dots li.slick-active button::before {
    content: "";
    width: 7px;
    height: 7px;
    background-color: transparent;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid white;
    border-radius: 50%;
}

/* Slick Arrows */
.slick-prev,
.slick-next {
    z-index: 10;
}

.slick-prev {
    left: 70px;
}

.slick-next {
    right: 70px;
}

.slick-prev::before,
.slick-next::before {
    font-size: 24px;
    color: white;
    position:absolute;
       font-family: inherit;
       transform:translate(0px, 240px)
}

.slick-prev::before {
    content: '←';
}

.slick-next::before {
    content: '→';
}

@media (max-width:800px) {
    .slide-content {
        flex-direction: column;
        gap: 10px;
    }

    .slide-content-btn {
        width: 100%;
        padding: 10px;
    }

    .slide-content-heading {
        width: 100%;
    }
}
</style>

<div class="slider-main">
  {% for block in section.blocks %}
    <div class="slide" style="background-image: url('{{ block.settings.background_image | image_url}}');">
      <div class="slide-content">
        <h1 class="slide-content-heading">{{ block.settings.heading }}</h1>
        {% if block.settings.button_link %}
        <a href="{{ block.settings.button_link }}" class="slide-content-btn">
          <span class="btn-fill"></span>
          <span class="btn-text">{{ block.settings.button_label }}</span>
        </a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Earphones Hero Slider",
  "max_blocks": 5,
  "class": "slider-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto Rotate Slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Change Interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide Title"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Text",
          "default": "Explore Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Earphones Slider",
      "category": "Custom",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

<!-- 2️⃣ Include jQuery & Slick JS from CDN and initialize -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script
  type="text/javascript"
  src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"
></script>
<script>
  $(document).ready(function () {
  $(".slider-main").slick({
    dots: true,
    infinite: true,
    speed: 800,
    slidesToShow: 1, // Showing multiple slides
    slidesToScroll: 1,
    autoplay: true,
    autoplaySpeed: 3000,
    pauseOnHover: true,
    arrows: true,
    adaptiveHeight: false,
    centerMode: false, // Must be false for gaps
    variableWidth: false, // Must be false for gaps

    responsive: [
      {
        breakpoint: 992,
        settings: {
          arrows: false,
          slidesToShow: 1, // Adjust for smaller screens
        },
      },
      {
        breakpoint: 768,
        settings: {
          dots: false,
          slidesToShow: 1, // Single slide on mobile
        },
      },
    ],
  });
});


  </script>