<style>

.slide-content a {
    text-decoration: none;
    color: black;
}

.slider-main {
    width: 90%;
    margin: 20px auto;
    height: 90vh;
    position: relative;
    /* Full viewport height */

}

.slide {
    width: 100%;
    height: 90vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    margin: 0px 10px;
    border-radius: 10px;
    padding: 0px 50px 80px;

    display: flex;
    flex-direction: column;
    align-content: flex-end;
    position: relative;
    z-index: 0;
}

.slide::before {
    position: absolute;
    content: "";
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.315);
    top: 0;
    left: 0;
    border-radius: 10px;
    z-index: 1;

}

.slide:hover {
    cursor: grab
}

.slide1 {
    background-image: url("/home-slider-02.webp");
    background-color: #f5f5f5;
    /* Fallback color */
}

.slide2 {
    background-image: url("/image.png");
    background-color: #e0e0e0;
}

.slide3 {
    background-image: url("/home-slider-02.webp");
    background-color: #d0d0d0;
}

.slide-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 99999;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.089);
    position: relative;
}

.slide-content-heading {
    color: white;
    width: clamp(400px, 600px, 600px);
    font-size: clamp(1rem, 3.368vw, 4rem);
    cursor: default;

}


.slide-content-btn {
    cursor: pointer;
    padding: 16px 32px;
    background-color: #fff;
    border-radius: 50px;
    transition: all 0.3s ease-in-out;
    border: 1px solid transparent;
    position: relative;
    z-index: 1;
    color: black;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.slide-content-btn:hover {
    border: 1px solid white;
    color: white;
}

.slide-content-btn .btn-fill {
    background-color: #000000;
    border-radius: 50%;
    width: 150%;
    height: 200%;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 0);
    transition: transform 0.4s ease-in-out;
    z-index: 0;
    /* Set below text */
}

.slide-content-btn:hover .btn-fill {
    transform: translate(-50%, -90%);
}

.slide-content-btn .btn-text {
    position: relative;
    z-index: 2;
    /* Text above fill */
    transition: color 0.3s ease-in-out;
}



/* Slick slider dots customization */

.slick-dots {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 30px;
    display: flex;
    gap: 10px;
    list-style: none;
}


.slick-dots li button {
    width: 6px;
    height: 6px;
    background-color: rgb(255, 255, 255);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-size: 0;
}

.slick-dots li button:before {
    content: none;
}

.slick-dots li.slick-active button {
    background-color: #000000;
    position: relative;
}

.slick-dots li.slick-active button::before {
    content: "";
    width: 7px;
    height: 7px;
    background-color: transparent;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid white;
    border-radius: 50%;
}

/* Slick Arrows */
.slick-prev,
.slick-next {
    font-size: 0;
    background: none;
    border: none;
    position: absolute;
    bottom: 2%;
    transform: translateY(-50%);
    z-index: 10;
    cursor: pointer;
}

.slick-prev {
    left: 60px;
}

.slick-next {
    right: 60px;
}

.slick-prev::before,
.slick-next::before {
    font-size: 24px;
    color: white;
}

.slick-prev::before {
    content: '←';
}

.slick-next::before {
    content: '→';
}

@media (max-width:800px) {
    .slide-content {
        flex-direction: column;
        gap: 10px;
    }

    .slide-content-btn {
        width: 100%;
        padding: 10px;
    }

    .slide-content-heading {
        width: 100%;
    }
}
</style>

<div class="slider-main">
  {% for block in section.blocks %}
    <div class="slide" style="background-image: url({{ block.settings.background_image | image_url: 'master' }});">
      <div class="slide-content">
        <h1 class="slide-content-heading">{{ block.settings.heading }}</h1>
        {% if block.settings.button_link %}
        <a href="{{ block.settings.button_link }}" class="slide-content-btn">
          <span class="btn-fill"></span>
          <span class="btn-text">{{ block.settings.button_label }}</span>
        </a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Earphones Hero Slider",
  "max_blocks": 5,
  "class": "slider-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto Rotate Slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide Change Interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide Title"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Text",
          "default": "Explore Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Earphones Slider",
      "category": "Custom",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
