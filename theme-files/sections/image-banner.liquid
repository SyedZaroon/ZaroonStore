{%- liquid
  assign bg_color_1 = section.settings.background_color_1 | default: '#FDF7F0'
  assign bg_color_2 = section.settings.background_color_2 | default: '#FFF5E6'
  assign accent_color = section.settings.accent_color | default: '#FF6B35'
  assign accent_color_rgb = accent_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign accent_color_hover = accent_color | color_darken: 15
-%}

<style>
  .protein-banner{
    padding: 220px 0px 120px 0px;
    background-color: {{ section.settings.background_color }};
    overflow:hidden;
    position:relative;
    display: flex;
    align-items: center;
    max-height: 600px;
  }
.circle{
  border-radius:100%;
    background-color: {{ section.settings.accent_color }};
    position:absolute;
}
  .circle-one{
    width:119px;
    height:119px;
    top:-53px;
    left:-56px;
  }

    .circle-two{
    width:231px;
    height:231px;
    bottom:-130px;
    left:-100px;
  }

    .circle-three{
    width:231px;
    height:231px;
    top:50%;
    right:-150px;
    transform:translateY(-50%);
  }

  .cup-img{
    max-width:217px;
    position:absolute;
    bottom:0;
    right:0;
  }

  .glass-img{
        position: absolute;
    top: 0px;
    max-width: 209px;
  }

  
  #Banner-{{ section.id }} .protein-banner__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  
  #Banner-{{ section.id }} .protein-banner__content {
    z-index: 2;
  }
  
  #Banner-{{ section.id }} .protein-banner__tag {
    display: inline-block;
    color: {{ accent_color }};
    margin-bottom: 4px;
  }
  
  #Banner-{{ section.id }} .protein-banner__title {
    font-size: clamp(24px, calc(2vw + 20px), 64px);
    font-weight: 700;
    line-height: 120%;
    margin: 0px 0px 8px 0px;
    color: #2C2C2C;
    position:relative;
  }

.protein-banner__title:after {
  position: absolute;
  content: "";
  max-width: 200px;              /* adjust size */
  height: 40px;              /* match your wave viewBox height */
  background: no-repeat center/contain url('{{ "wave.svg" | asset_url }}');
  bottom:0px;
   color: {{ section.settings.accent_color }};
}
  
  #Banner-{{ section.id }} .protein-banner__title-highlight {
    color: {{ accent_color }};
  }
  
  #Banner-{{ section.id }} .protein-banner__subtitle {
    color: #242424B2;
    margin: 0px 0px 30px 0px;
    line-height: 1.6;
  }
  

  .btn-img{
    position:absolute;
    right: -46px;
  }

  .btn-tagline{
    position: absolute;
    right: -167px;
    color: #FB740F80;
    top: -72px;
    font-family: cursive;
    font-weight: 400;
    font-size: 28px;
  }
  

  
  #Banner-{{ section.id }} .protein-banner__image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width:500px;
  }
  
  #Banner-{{ section.id }} .protein-banner__product-image {
    max-width: 100%;
    height: auto;
    z-index: 2;
    border-radius: 20px;
  }
  
  #Banner-{{ section.id }} .protein-banner__bg-circle {
    position: absolute;
    max-width: 400px;
    height: 400px;
    background: linear-gradient(45deg, {{ accent_color }}, {{ accent_color | color_lighten: 10 }});
    border-radius: 50%;
    right: -100px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.1;
  }
  
  
  @media (max-width: 933px) {
    #Banner-{{ section.id }} .protein-banner__container {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 0 20px;
      text-align: center;
      justify-items: center;
    }
    
    .protein-banner{
      max-height:unset;
      padding: clamp(100px, 20vh, 250px) clamp(20px, 5vw, 80px) 50px clamp(10px, 2vw, 40px);
    }

    .btn-tagline,
    .btn-img {
    display:none;
}
    
  }
</style>

<div class="protein-banner" id="Banner-{{ section.id }}">
  <div class="protein-banner__container page-width">
    <div class="protein-banner__content">
      {%- if section.settings.tag_line != blank -%}
        <div class="protein-banner__tag h2">{{ section.settings.tag_line }}</div>
      {%- endif -%}
      
      {%- if section.settings.title_part_1 != blank or section.settings.title_highlight != blank or section.settings.title_part_2 != blank -%}
        <h1 class="protein-banner__title">
          {{ section.settings.title_part_1 }}
          {%- if section.settings.title_highlight != blank -%}
            <span class="protein-banner__title-highlight">{{ section.settings.title_highlight }} </span>
          {%- endif -%}
          {{ section.settings.title_part_2 }}
        </h1>
      {%- endif -%}
      
      {%- if section.settings.subtitle != blank -%}
        <p class="protein-banner__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="primary-btn">
          {{ section.settings.button_label }}

          {%- if section.settings.button_tagline !=blank -%}
        <div class="btn-img" >
          <img
            src="{{ 'Vector.png' | asset_url }}"
            width="38px";
            height="38px";
          >
        </div>
        <p class="btn-tagline">{{ section.settings.button_tagline }} </p>
      {%- endif -%}
        </a>

      {%- endif -%}
    </div>
    
    <div class="protein-banner__image-wrapper">
      {%- if section.settings.product_image != blank -%}
        <img 
          src="{{ section.settings.product_image | image_url}}" 
          alt="{{ section.settings.product_image.alt | escape }}"
          class="protein-banner__product-image"
          loading="lazy"
          width="auto"
          height="auto"
        >
      {%- endif -%}
      
    </div>
  </div>

  <div class="circle circle-one"></div>
  <div class="circle circle-two"></div>
  <div class="circle circle-three"></div>
  {%- if section.settings.cup_image !=blank -%}
  <img
    src="{{ section.settings.cup_image | img_url }}"
    alt="{{ section.settings.product_image.alt | escape }}"
    class="cup-img"
    loading="lazy"
    width="auto"
    height="auto"
  >
  {%-  endif -%}

  {%- if section.settings.glass_image !=blank -%}
  <img
    src="{{ section.settings.glass_image | img_url }}"
    alt="{{ section.settings.glass_image.alt | escape }}"
    class="glass-img"
    loading="lazy"
    width="auto"
    height="auto"
  >
  {%-  endif -%}

</div>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "tag_line",
      "label": "Tag Line",
      "default": "Energize Your Routine",
      "info": "Small italic text above the title"
    },
    {
      "type": "text",
      "id": "title_part_1",
      "label": "Title Part 1",
      "default": "Daily ",
      "info": "Text before the highlighted word"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight",
      "default": "Habits",
      "info": "Text to be highlighted in orange"
    },
    {
      "type": "text",
      "id": "title_part_2",
      "label": "Title Part 2",
      "default": " for a Stronger You",
      "info": "Text after the highlighted word"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover how daily habits build a healthier, vibrant life with our unique beverages.",
      "info": "Description text below the title"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
     {
      "type": "text",
      "id": "button_tagline",
      "label": "Button Tagline",
      "default": "Sip & Thrive"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "info": "Leave empty to disable button"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Recommended size: 600x600px"
    },
    {
      "type": "image_picker",
      "id": "cup_image",
      "label": "Cup Image",
      "info": "Recommended size: 244x141px"
    },
    {
      "type": "image_picker",
      "id": "glass_image",
      "label": "Glass Image",
      "info": "Recommended size: 244x141px"
    },
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FDF7F0",
      "info": "First color of the gradient background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF6B35",
      "info": "Color for highlighted text, button, and decorative elements"
    }
  ],
  "presets": [
    {
      "name": "Image Banner",
      "settings": {
        "tag_line": "Energize Your Routine",
        "title_part_1": "Daily ",
        "title_highlight": "Habits",
        "title_part_2": " for a Stronger You",
        "subtitle": "Discover how daily habits build a healthier, vibrant life with our unique beverages.",
        "button_label": "Shop Now",
      }
    }
  ]
}
{% endschema %}
