{% style %}
  .custom-contact-page{
      background-color:{{ section.settings.bg_color }};
      padding-bottom:50px;
  }
  .contact-grid{
    display:grid;
grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
gap:clamp(20px, 5vw, 100px);
  }

  .contact-icon-box{
    margin-top:40px;
    display:flex;
    flex-direction:column;
    gap:40px;
  }
  .icon-block{
        display: flex;
    gap: 24px;
    align-items: center;
  }
{% endstyle %}

<div class="" >
<div class=" contact-grid page-width">

  <div class="custom-contact-page-left">

    <div class="contact-content">
      <h2 class="h2 tagline">{{ section.settings.tagline }}</h2>
      <p class="section-title">{{ section.settings.heading }}</p>
      <p>{{ section.settings.desc }}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="contact-icon-box">
        {%- for item in section.blocks -%}
          <div id="block-{{ forloop.index }}" class="icon-block">
<img src="{{ item.settings.img | image_url: width: 30 }}" alt="icon" width="30" height="30">
            <div>
              <h2 style="margin:0px" class="h2">{{ item.settings['icon-box-text'] }}</h2>
              <p style="margin:0px">{{ item.settings['icon-box-desc'] }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  <div>
    {% render 'custom-contact-form' %}
  </div>
</div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "class": "custom-contact-page",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Keep Connected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lets Get In Touch With Our Team"
    },
    {
      "type": "text",
      "id": "desc",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo."
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDF7F0"
    }
  ],
  "blocks": [
    {
      "type": "icon_box",
      "name": "Iocn Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon-box-text",
          "label": "Box Heading",
          "default": "Head Office Address"
        },
        {
          "type": "text",
          "id": "icon-box-desc",
          "label": "Box Description",
          "default": "Lumbung Hidup St. 42 East Java Madiun City"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
