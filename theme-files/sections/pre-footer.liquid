</clipPath>
</defs>
</svg>

          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="pre-footer-image-wrapper">
      {%- if section.settings.product_image != blank -%}
        <img 
          src="{{ section.settings.product_image | image_url }}" 
          alt="{{ section.settings.product_image.alt | escape }}"
          class="pre-footer-image"
          loading="lazy"
          width="auto"
          height="auto"
        >
      {%- endif -%}
    </div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "Pre Footer",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Reduce Your Stress with Every Sip",
      "info": "Main heading for the section"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover the soothing comfort in our power shakes and adaptogen-infused coffees. Nurture yourself with each delicious choice.",
      "info": "Description text below the title"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Go to Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "info": "Leave empty to disable button"
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Product image - recommended size: 500x400px"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#F8F9FA"  
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content Background Color",
      "default": "#FF6B35" 
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FF6B35"
    }
  ],
  "presets": [
    {
      "name": "Pre Footer",
      "settings": {
        "title": "Reduce Your Stress with Every Sip",
        "description": "Discover the soothing comfort in our power shakes and adaptogen-infused coffees. Nurture yourself with each delicious choice.",
        "button_label": "Go to Shop"
      }
    }
  ]
}
{% endschema %}
