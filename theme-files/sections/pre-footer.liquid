{%- liquid
  assign bg_color = section.settings.background_color | default: '#FF6B35'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign button_bg = section.settings.button_background | default: '#FFFFFF'
  assign button_text = section.settings.button_text_color | default: '#FF6B35'
-%}

<style>
  .pre-footer-wrapper {
    background: {{ bg_color }};
    padding: clamp(40px, 6vw, 80px) 20px;
  }
  
  .pre-footer-section {
    color: {{ text_color }};
    position: relative;
    border-radius: 20px;
    margin: 0 auto;
    background-color:{{ section.settings.content_background_color }} 
    }

  .pre-footer-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    min-height: 400px;
  }

  .pre-footer-content {
    z-index: 2;
    position: relative;
  }

  .pre-footer-title {
    color: {{ text_color }};
    margin: 0 0 12px 0;
  }

  .pre-footer-description {
    font-size: clamp(14px, 1.5vw, 18px);
    line-height: 1.6;
    color: {{ text_color }};
    opacity: 0.9;
    margin: 0 0 clamp(24px, 4vw, 32px) 0;
    max-width: 500px;
  }

  .pre-footer-button {
    display: inline-flex;
    align-items: center;
    background: {{ button_bg }};
    color: {{ button_text }};
    padding: clamp(12px, 2vw, 16px) clamp(24px, 4vw, 32px);
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: clamp(14px, 1.5vw, 16px);
    transition: all 0.3s ease;
    gap: 8px;
  }

  .pre-footer-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    background: {{ button_bg }};
    color: {{ button_text }};
  }

  .pre-footer-button svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .pre-footer-image-wrapper {
    position: absolute;
    right: 0;
    top: -4%;
  }

  .pre-footer-image {
    max-width: 100%;
    height: auto;
    max-height: 502px;
    object-fit: contain;
  }

  /* Responsive Design */

  @media (max-width: 900px) {

    .pre-footer-container {
    grid-template-columns: 1fr;
    text-align: center;
    }

    .pre-footer-image-wrapper{
      position:unset;
    }

    .pre-footer-description{
      max-width:unset;
    }
    .pre-footer-container{
      gap:unset;
      padding: 40px 20px 0px 20px;
    }

  }

</style>

<div class="pre-footer-wrapper">
  <div class="pre-footer-section page-width">
    <div class="pre-footer-container">
    <div class="pre-footer-content">
      
      {%- if section.settings.title != blank -%}
        <h2 class="pre-footer-title section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <p class="pre-footer-description">{{ section.settings.description }}</p>
      {%- endif -%}
      
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="pre-footer-button">
         <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_97_229)">
<path d="M15.142 2.718C14.9545 2.49296 14.7197 2.31197 14.4544 2.18788C14.189 2.06379 13.8996 1.99964 13.6067 2H2.828L2.8 1.766C2.7427 1.27961 2.50892 0.831155 2.14299 0.505652C1.77706 0.180149 1.30442 0.000227862 0.814667 0L0.666667 0C0.489856 0 0.320286 0.0702379 0.195262 0.195262C0.0702379 0.320286 0 0.489856 0 0.666667C0 0.843478 0.0702379 1.01305 0.195262 1.13807C0.320286 1.2631 0.489856 1.33333 0.666667 1.33333H0.814667C0.977956 1.33335 1.13556 1.3933 1.25758 1.50181C1.3796 1.61032 1.45756 1.75983 1.47667 1.922L2.394 9.722C2.48923 10.5332 2.87899 11.2812 3.48927 11.824C4.09956 12.3668 4.8879 12.6667 5.70467 12.6667H12.6667C12.8435 12.6667 13.013 12.5964 13.1381 12.4714C13.2631 12.3464 13.3333 12.1768 13.3333 12C13.3333 11.8232 13.2631 11.6536 13.1381 11.5286C13.013 11.4036 12.8435 11.3333 12.6667 11.3333H5.70467C5.29204 11.3322 4.88987 11.2034 4.55329 10.9647C4.21671 10.726 3.96221 10.389 3.82467 10H11.7713C12.5529 10 13.3096 9.72549 13.9092 9.22429C14.5089 8.7231 14.9134 8.02713 15.052 7.258L15.5753 4.35533C15.6276 4.06734 15.6158 3.77138 15.5409 3.48843C15.4661 3.20547 15.3299 2.94245 15.142 2.718Z" fill="#FB740F"/>
<path d="M4.66671 15.9999C5.40309 15.9999 6.00004 15.403 6.00004 14.6666C6.00004 13.9302 5.40309 13.3333 4.66671 13.3333C3.93033 13.3333 3.33337 13.9302 3.33337 14.6666C3.33337 15.403 3.93033 15.9999 4.66671 15.9999Z" fill="#FB740F"/>
<path d="M11.3333 15.9999C12.0697 15.9999 12.6667 15.403 12.6667 14.6666C12.6667 13.9302 12.0697 13.3333 11.3333 13.3333C10.597 13.3333 10 13.9302 10 14.6666C10 15.403 10.597 15.9999 11.3333 15.9999Z" fill="#FB740F"/>
